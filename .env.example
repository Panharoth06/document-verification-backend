# ==============================================================================
# Document Verification Backend - Environment Configuration
# ==============================================================================

# Server port exposed on the host
PORT=8080

# PostgreSQL Database Configuration
POSTGRES_DB=document_verification_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Frontend Application URL (used by Playwright to render certificate HTML into PDF)
# Note: In Docker, use http://host.docker.internal:3000 if frontend runs on host machine
FRONTEND_BASE_URL=http://localhost:3000
